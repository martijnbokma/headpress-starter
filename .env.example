# WordPress GraphQL endpoint (server-side only). `bun run setup` fills in the
# local DDEV address; plain http because Node does not trust DDEV's local CA.
WP_GRAPHQL_URL=

# Public site URL, used for canonical and Open Graph URLs.
SITE_URL=http://localhost:4321

# Shared with WordPress (HEADLESS_REVALIDATE_SECRET). scripts/setup.sh fills it in.
HEADLESS_REVALIDATE_SECRET=
