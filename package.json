{
  "name": "headpress-starter",
  "description": "HeadPress - High-performance Astro hybrid frontend for Headless WordPress",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "check": "astro check",
    "test": "vitest run",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.5",
    "graphql": "^16.14.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typed-document-node": "^7.1.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
