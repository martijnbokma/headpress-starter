---
import { SITE_URL } from 'astro:env/server';
import '~/styles/theme.css';

interface Props {
  title: string;
  description?: string;
  /** Path for the canonical URL; defaults to the current path. */
  path?: string;
  noindex?: boolean;
}

const { title, description = '', path = Astro.url.pathname, noindex = false } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-4">Skip to content</a>
    <main id="main" class="mx-auto max-w-[70ch] px-4 py-12">
      <slot />
    </main>
  </body>
</html>
